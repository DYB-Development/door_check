<%= ui_data_table(items: DoorCheck::Credential.where(person: person), columns: [ { label: "Method" }, { last_used: "Last used" }, { accepted_by: "Accepted by" } ],
                  empty_message: "No sign-in methods set up yet.") %>
<% if DoorCheck.configuration.offered_methods.include?(:authenticator_app) %>
  <%= ui_button(label: "Set up an authenticator app", href: door_check.new_authenticator_path, variant: :secondary) %>
<% end %>
