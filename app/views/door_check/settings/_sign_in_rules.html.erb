<% rule = DoorCheck::AccountRule.for(account) %>
<%= ui_panel do %>
  <%= ui_form(action: submit_url, method: :patch) do %>
    <%= ui_section(title: "Accepted methods", spacing: :sm) do %>
      <% DoorCheck.configuration.offered_methods.each do |method_name| %>
        <%= ui_checkbox_row(name: "accepted_methods[]", value: method_name, label: method_name.to_s.humanize, checked: rule.accepts?(method_name)) %>
      <% end %>
    <% end %>
    <%= ui_section(title: "Second step", spacing: :sm) do %>
      <%= ui_form_field(attribute: "second_step_required", label: "Require a second step to enter this account",
                        type: :checkbox, value: (rule.second_step_required ? "1" : "0"),
                        hint: "Members who signed in with only a password are asked for their authenticator code when they enter.") %>
    <% end %>
    <% if DoorCheck.configuration.people_choose_second_step %>
      <%= ui_form_field(attribute: "members_choose_second_step", label: "Members choose their own second step",
                        type: :checkbox, value: (rule.members_choose_second_step ? "1" : "0")) %>
    <% else %>
      <%= ui_alert(message: "This app decides when members are asked for a second step.") %>
    <% end %>
    <%= ui_button(label: "Save") %>
  <% end %>
<% end %>
