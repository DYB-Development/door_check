<%= ui_form_page(title: "Add a passkey", subtitle: "Use this device's fingerprint, face or PIN, or a hardware key such as a YubiKey.", trail: []) %>
<%= ui_page(max_width: :md) do %>
  <%= ui_alert(message: @error, type: :error) if @error %>
  <%= ui_form(action: door_check.passkeys_path, data: { controller: "door-check-passkey", door_check_passkey_ceremony_value: "create",
                                                       door_check_passkey_options_value: @options.to_json, action: "submit->door-check-passkey#run" }) do %>
    <%= ui_form_field(attribute: "name", label: "Name", required: true, hint: "Such as Work laptop or YubiKey") %>
    <input type="hidden" name="credential" data-door-check-passkey-target="credential">
    <%= ui_button(label: "Add") %>
  <% end %>
<% end %>
