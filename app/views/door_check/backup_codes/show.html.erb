<%= ui_page(max_width: :md) do %>
  <%= ui_page_header(title: "Your backup codes", subtitle: "Save these somewhere safe now. Each works once as a second step, and they are not shown again.") %>
  <ul class="grid grid-cols-2 gap-2">
    <% @codes.each do |code| %>
      <li><code><%= code %></code></li>
    <% end %>
  </ul>
<% end %>
