<%= ui_page(max_width: :md) do %>
  <% if @second_step_set_up %>
    <%= ui_page_header(title: "Confirm it's you", subtitle: "Enter the code from your authenticator app or one of your backup codes.") %>
    <%= ui_alert(message: @error, type: :error) if @error %>
    <%= ui_form(action: door_check.second_step_path) do %>
      <%= ui_form_field(attribute: "code", label: "Code", required: true, autofocus: true,
                        autocomplete: "one-time-code", inputmode: "numeric", autocapitalize: "none") %>
      <%= ui_button(label: "Verify") %>
    <% end %>
  <% else %>
    <%= ui_page_header(title: "Set up a second step", subtitle: "A second step is required here, and you have none set up yet.") %>
    <% @setups.each do |method_name, setup_page| %>
      <%= ui_button(label: "Set up #{method_name.to_s.humanize.downcase}", href: door_check.public_send(setup_page)) %>
    <% end %>
  <% end %>
<% end %>
