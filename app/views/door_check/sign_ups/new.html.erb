<%= ui_page(max_width: :md) do %>
  <%= ui_section(title: "Sign up", subtitle: "Enter your name and email address.") do %>
    <%= ui_alert(message: @error, type: :error) if @error %>
    <%= ui_form(action: door_check.sign_up_path(request.query_parameters)) do %>
      <% identity_fields = capture do %>
        <%= ui_form_field(attribute: "name", label: "Name", value: params[:name], required: true, autofocus: true, autocomplete: "name") %>
        <%= ui_form_field(attribute: "email", label: "Email", type: :email, value: params[:email], required: true,
                          autocomplete: "email", autocapitalize: "none") %>
      <% end %>
      <% if sign_in_method_tabs.many? %>
        <%= ui_tab_switcher(tabs: sign_in_method_tabs.map { |tab| tab[:label] }) do |switcher| %>
          <%= identity_fields %>
          <% sign_in_method_tabs.each do |tab| %>
            <% switcher.with_panel do %>
              <%= render "door_check/sign_ups/sign_in_method_fields", method_name: tab[:method_name] %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= identity_fields %>
        <%= render "door_check/sign_ups/sign_in_method_fields", method_name: sign_in_method_tabs.first[:method_name] %>
      <% end %>
      <%= ui_form_field(attribute: "agreement", label: DoorCheck.configuration.sign_up_agreement_label, type: :checkbox, value: params[:agreement],
                        required: true) %>
      <%= ui_link_list(rows: DoorCheck.configuration.sign_up_agreement_links.call(controller)
                                    .map { |document| { label: document.fetch(:title), href: document.fetch(:url) } }, new_tab: true) %>
      <%= ui_button(label: "Sign up") %>
    <% end %>
  <% end %>
<% end %>
