<!DOCTYPE html>
<html <%= keystone_theme_attributes %>>
<head>
  <title>Door check</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= stylesheet_link_tag DoorCheck.configuration.stylesheet, media: "all" %>
  <%= stylesheet_link_tag    "door_check/application", media: "all" %>
  <%= javascript_importmap_tags %>
</head>
<body>

<% if content_for?(:form_page) %>
  <%= ui_navbar do |navbar| %>
    <% navbar.with_mobile_left do %>
      <%= ui_mobile_header(title: content_for(:form_page_title), back_url: content_for(:form_page_back_url).presence,
                           subtitle: content_for(:form_page_subtitle)) %>
    <% end %>
  <% end %>
<% end %>

<%= yield %>

</body>
</html>
